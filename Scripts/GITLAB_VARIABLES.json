  "setup_instructions": {
    "step_1": {
      "title": "Wait for Redis",
      "duration": "5-10 minutes",
      "command": "aws elasticache describe-replication-groups --replication-group-id ecs-cluster-int-redis --region us-east-1 --profile $AWS_PROFILE",
      "check": "Status should change from 'creating' to 'available'"
    },
    "step_2": {
      "title": "Get Redis Credentials",
      "duration": "1 minute",
      "once_redis_available": true,
      "commands": {
        "host": "aws elasticache describe-replication-groups --replication-group-id ecs-cluster-int-redis --region us-east-1 --profile $AWS_PROFILE --query 'ReplicationGroups[0].PrimaryEndpoint.Address' --output text",
        "password": "aws secretsmanager get-secret-value --secret-id ecs-cluster-int/redis/auth-token --region us-east-1 --profile $AWS_PROFILE --query SecretString --output text | jq -r '.auth_token'"
      }
    },
    "step_3": {
      "title": "Set GitLab Variables",
      "duration": "15 minutes",
      "url": "https://gitlab.com/devops8004932/ecommerce-app-v1/-/settings/ci_cd",
      "instructions": [
        "Go to Settings → CI/CD → Variables",
        "Click 'Add Variable' for each variable",
        "Enter Key and Value",
        "Check 'Protected' for all",
        "Check 'Masked' for secrets (passwords, tokens)"
      ]
    },
    "step_4": {
      "title": "Push Code & Deploy",
      "duration": "10 minutes",
      "command": "git push origin main",
      "note": "Pipeline will automatically build, test, and deploy"
    }
  }
